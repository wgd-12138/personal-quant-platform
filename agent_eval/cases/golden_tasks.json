        "no_write": true,
        "plan_missing": false,
        "citations_min": 0,
        "planned_tools": [
          "daily_pack_preview"
        ]
      },
      "why": "日报预览是只读外网能力，只是把内容算出来，不该要人工确认，也不该落盘。",
      "trap": "report_generate 曾被错误地要求人工审批；能力等级必须取自注册表的 ToolSpec，不能凭意图写死。"
    },
    {
      "case_id": "gt-04-history-report",
      "split": "dev",
      "query": "昨天那份日报讲了什么",
      "slots": {},
