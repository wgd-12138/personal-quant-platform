      "query": "把日报推送到飞书",
      "slots": {},
      "approval": "none",
      "expect": {
        "intent": "push_request",
        "tools": [],
        "forbidden_tools": [
          "push_send",
          "push_preview"
        ],
        "tools_exact": true,
        "no_write": true,
        "plan_missing": true,
        "citations_min": 0,
        "allowed_error_codes": [
          "RAG_UNAVAILABLE",
          "PLAN_MISSING_ARGUMENTS"
